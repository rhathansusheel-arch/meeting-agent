# ------------------------------------------------------------------
# Copy this file to a new file named ".env" and fill in the real values.
# NEVER share your .env file or commit it to git.
# ------------------------------------------------------------------

# From BotFather on Telegram (Stage 1, step 3)
TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token-here

# YOUR personal Telegram chat ID so the bot only talks to you (Stage 1, step 4).
# For more than one owner, separate the ids with commas, e.g. 12345,67890
OWNER_CHAT_ID=put-your-numeric-chat-id-here

# Free Google Gemini API key from https://aistudio.google.com/apikey
# Used to understand your messages. If missing/invalid, the bot falls back to
# basic rule-based parsing automatically.
GEMINI_API_KEY=put-your-gemini-api-key-here

# ------------------------------------------------------------------
# Note: your Google login does NOT go here.
# Google uses two files in this folder instead:
#   credentials.json  (you download it in Stage 1, step 5)
#   token.json        (created automatically the first time you log in, Stage 2)
# ------------------------------------------------------------------
